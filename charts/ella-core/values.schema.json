{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "nodes", "ran", "service", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "clusterDomain": {"type": "string", "minLength": 1},
    "nodes": {
      "description": "One entry per Ella Core node. One entry deploys a standalone node; three or more deploy a high-availability cluster.",
      "type": "array",
      "minItems": 1,
      "not": {"minItems": 2, "maxItems": 2},
      "items": {
        "type": "object",
        "required": ["ranAddress"],
        "properties": {
          "ranAddress": {
            "description": "N2/N3 address of the node, in CIDR notation.",
            "type": "string",
            "minLength": 1
          },
          "nodeSelector": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "ran": {
      "type": "object",
      "required": ["interface", "networkAttachment"],
      "properties": {
        "interface": {"type": "string", "minLength": 1},
        "networkAttachment": {
          "type": "object",
          "properties": {
            "create": {"type": "boolean"},
            "name": {"type": "string"},
            "master": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "enum": ["bridge", "private", "vepa", "passthru"]},
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dst"],
                "properties": {
                  "dst": {"type": "string"},
                  "gw": {"type": "string"}
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "config": {
      "description": "Ella Core configuration file content, merged over the settings the chart manages.",
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "nodePort": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "storageClassName": {"type": "string"}
      }
    },
    "resources": {"type": "object"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "securityContextConstraints": {
          "type": "object",
          "properties": {
            "create": {"enum": ["auto", true, false]}
          }
        }
      }
    },
    "seLinuxOptions": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "labels": {"type": "object"}
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"}
          }
        }
      }
    }
  }
}
